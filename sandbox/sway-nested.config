# Sway config for the hy3-lua docker test environment
# (environment/compose.yml mounts this at /config/sway-nested.config).
# The headless backend auto-creates one HEADLESS-1 output; the service
# command just sets its mode (an explicit create_output would add a
# phantom second output). See ../CLAUDE.md and ../environment/.

set $mod Mod4

bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+j focus down

bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+k move up
bindsym $mod+Shift+j move down

bindsym $mod+Return exec foot
bindsym $mod+q kill

# split orientation (no sway defaults; added for parity with hypr config)
bindsym $mod+v splitv
bindsym $mod+s splith
bindsym $mod+t splitt

default_border none
gaps inner 4
