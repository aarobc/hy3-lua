+    if (!primaryAllocator) {
+        // hy3-lua: the headless backend reports no DRM fd, so in a
+        // container (no GPU, no DRM devices of its own) the allocator
+        // is never created and the backend refuses to start. Fall back
+        // to a passed-through render node (e.g. /dev/dri/renderD128);
+        // the Hyprland renderer does the same discovery on its side.
+        for (int minor = 0; minor < 32 && !primaryAllocator; ++minor) {
+            auto path = std::format("/dev/dri/renderD{}", 128 + minor);
+            auto fd   = open(path.c_str(), O_RDWR);
+            if (fd < 0)
+                continue;
+            auto rfd = reopenDRMNode(fd, true);
+            if (rfd < 0) {
+                close(fd);
+                continue;
+            }
+            primaryAllocator = CGBMAllocator::create(rfd, self);
+        }
+    }
+ 
