--- a/src/backend/Headless.cpp
+++ b/src/backend/Headless.cpp
@@ -136,4 +136,21 @@
 
 int Aquamarine::CHeadlessBackend::drmRenderNodeFD() {
-    return -1;
+    // hy3-lua: the headless backend reports no DRM render node, but
+    // Hyprland's renderer still needs one for its GBM/EGL path. In a
+    // container there are no DRM devices of the backend's own; fall
+    // back to a passed-through render node (e.g. /dev/dri/renderD128)
+    // if present. Called once at compositor init; the fd stays open
+    // for the process lifetime (the renderer keeps using the node).
+    static int fd = -2;
+    if (fd == -2) {
+        fd = -1;
+        for (int minor = 0; minor < 32; ++minor) {
+            auto path = std::format("/dev/dri/renderD{}", 128 + minor);
+            if (int f = open(path.c_str(), O_RDWR); f >= 0) {
+                fd = f;
+                break;
+            }
+        }
+    }
+    return fd;
 }
